# Normalize all text files to LF, in the repository and in working copies, regardless of core.autocrlf.
# LF everywhere keeps the Dockerfile and anything copied into Linux containers byte-identical across hosts.
* text=auto eol=lf

# Windows-only scripts need CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files: never touch.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.zip binary
*.dll binary
*.exe binary
*.pdb binary
