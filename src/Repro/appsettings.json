{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Npgsql": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=repro;Username=postgres;Password=postgres"
  },
  "Repro": {
    "Container": "MsDi",
    "ContextRegistration": "Plain",
    "AliasRegistration": false,
    "ExtraDisposeProbability": 0,
    "Concurrency": 32,
    "ScopeDisposal": "Async",
    "DoubleDisposeMode": "PassThrough",
    "CancelProbability": 0.2,
    "MaxCancelDelayMs": 5,
    "AbandonReaderProbability": 0,
    "Interval": "00:00:00",
    "SummaryInterval": "00:00:10",
    "RetryOnFailure": true,
    "SeedRows": 5000,
    "Tenants": 10,
    "SelfTest": false,
    "CaptureFirstDisposerStack": true,
    "MaxDetailedLogs": 50
  }
}
